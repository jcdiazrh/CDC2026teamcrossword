# Copy this file to .env.local (same folder) and fill in the values.
# .env.local is git-ignored, so each teammate keeps their own.

# Spotify dashboard -> your app -> Settings -> Client ID
VITE_SPOTIFY_CLIENT_ID=

# Free Last.fm key (https://www.last.fm/api/account/create). Spotify's artist
# genres are deprecated and often come back empty, so we get genres here instead.
VITE_LASTFM_API_KEY=
